#!/bin/bash
# cloud-init bootstrap for RepoJudgeBench nodes (role: ${role}, index: ${index})
# Rendered by Terraform templatefile(); shell variables are written as $VAR or $${VAR}.
set -euxo pipefail
exec > >(tee -a /var/log/rjb-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
U=ubuntu
HOME_DIR=/home/$U
REPO=$HOME_DIR/nlp-project-
WORK=/opt/work

# ---- packages common to every node ------------------------------------------
apt-get update -y
apt-get install -y git curl rsync tmux jq unzip build-essential cmake \
                   python3 python3-venv python3-pip docker.io
systemctl enable --now docker
usermod -aG docker $U

# ---- private-network SSH between master and workers -------------------------
install -d -m 700 -o $U -g $U $HOME_DIR/.ssh
echo "${cluster_public_key}" >> $HOME_DIR/.ssh/authorized_keys
chown $U:$U $HOME_DIR/.ssh/authorized_keys
chmod 600 $HOME_DIR/.ssh/authorized_keys

# ---- code + Python environment + task sources --------------------------------
install -d -o $U -g $U $WORK
sudo -u $U git clone --branch "${repo_branch}" "${repo_url}" $REPO
# installs llama-cpp-python, numpy/pandas/statsmodels, ruff, bandit; downloads
# SWE-bench-Live / SWE-rebench / CodeJudgeBench at pinned revisions; checks Docker
sudo -u $U -H bash -lc "cd $REPO && WORK=$WORK bash scripts/shard_worker.sh setup"

%{ if role == "master" ~}
# ---- master only --------------------------------------------------------------
apt-get install -y texlive-latex-recommended texlive-latex-extra texlive-publishers \
                   texlive-fonts-recommended texlive-science latexmk cm-super
cat > $HOME_DIR/.ssh/id_ed25519 <<'KEY'
${cluster_private_key}
KEY
chown $U:$U $HOME_DIR/.ssh/id_ed25519
chmod 600 $HOME_DIR/.ssh/id_ed25519
cat > $HOME_DIR/.ssh/config <<'CFG'
Host 10.*
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
CFG
chown $U:$U $HOME_DIR/.ssh/config
echo "${worker_ips}" | tr ' ' '\n' > $HOME_DIR/workers.txt
chown $U:$U $HOME_DIR/workers.txt
# tokenizer used by make_items to measure prompt length
sudo -u $U -H bash -lc "mkdir -p $WORK/models && curl -sSL --retry 4 -o $WORK/models/qwen2.5-coder-1.5b-instruct-q8_0.gguf https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q8_0.gguf"
%{ endif ~}

touch /var/lib/rjb-bootstrap-done
